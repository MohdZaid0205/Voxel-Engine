<Window x:Class="Editor.Screens.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:local="clr-namespace:Editor"
        xmlns:controls="clr-namespace:Editor.Resources.Controls"
        mc:Ignorable="d"
        Title="Voxel Engine (Project)" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource brush_bg_base}"
        Icon="/editor/Resources/Icons/app-icon.png">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="250"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="240" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <controls:SpinnerControl x:Name="loadingAnimation" Size="100" Visibility="Hidden"/>
        </Grid>

        <GridSplitter Grid.Column="1" 
                  Width="3" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Stretch" 
                  ResizeDirection="Columns" 
                  ResizeBehavior="PreviousAndNext"
                  Background="{DynamicResource brush_bg_overlay}" />

        <Grid Grid.Column="2" Background="{DynamicResource brush_bg_elevated}">
            <StackPanel x:Name="optionsStackPanel" Margin="3">

                <Button x:Name="CreateNewProjectButton"
                        Click="CreateNewProjectButton_Click"
                        HorizontalContentAlignment="Left" Padding="8,4"
                        Style="{DynamicResource ButtonStyle.Secondary}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image Source="{DynamicResource add-project-icon}" 
                               Width="20"/>
                        <TextBlock Text="Create New Project" FontWeight="Bold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button HorizontalContentAlignment="Left" Padding="8,4"
                        Style="{DynamicResource ButtonStyle.Secondary}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image Source="{DynamicResource empty-project-icon}" 
                               Width="20"/>
                        <TextBlock Text="Continue Without Project" FontWeight="Bold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button HorizontalContentAlignment="Left" Padding="8,4" IsEnabled="false"
                        Style="{DynamicResource ButtonStyle.Secondary}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image Source="{DynamicResource project-template-icon}" 
                               Width="20"/>
                        <TextBlock Text="Use Template" FontWeight="Bold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>
        
    </Grid>
</Window>
