<Window
    x:Class="Editor.Views.Screens.NewProjectScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModles="clr-namespace:Editor.ViewModels"
    Title="New Project"
    Width="800"
    Height="300"
    Icon="{DynamicResource app-icon}"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <viewModles:CreateProjectViewModel />
    </Window.DataContext>

    <Grid Background="{DynamicResource brush_bg_hover}" MouseLeftButtonDown="Body_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="10,10,10,5"
            Background="Transparent">

            <StackPanel Orientation="Vertical">
                <Grid Height="30" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Label
                        Grid.Column="0"
                        Margin="0,0,1,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource brush_bg_surface}"
                        Content="Name"
                        FontWeight="Bold"
                        Foreground="{DynamicResource brush_neutral_default_foreground}" />

                    <TextBox
                        Grid.Column="1"
                        BorderBrush="{DynamicResource brush_bg_surface}"
                        Style="{DynamicResource TextBoxStyle.Secondary}"
                        Tag="ProjectNumber0"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>

                <Grid Height="30" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Label
                        Grid.Column="0"
                        Margin="0,0,1,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource brush_bg_surface}"
                        Content="Path"
                        FontWeight="Bold"
                        Foreground="{DynamicResource brush_neutral_default_foreground}" />

                    <TextBox
                        Grid.Column="1"
                        BorderBrush="{DynamicResource brush_bg_surface}"
                        Style="{DynamicResource TextBoxStyle.Secondary}"
                        Tag="../Path/to/Project"
                        Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Column="2"
                        Width="30"
                        Padding="5"
                        Click="BrowseFile_Click"
                        Foreground="{DynamicResource brush_accent}"
