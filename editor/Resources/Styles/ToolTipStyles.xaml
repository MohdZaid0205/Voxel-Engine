<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  Global ToolTip                                        -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background"     Value="{DynamicResource brush_bg_elevated}"/>
        <Setter Property="Foreground"     Value="{DynamicResource brush_text_primary}"/>
        <Setter Property="BorderBrush"    Value="{DynamicResource brush_border_default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"     Value="Segoe UI"/>
        <Setter Property="FontSize"       Value="12"/>
        <Setter Property="Padding"        Value="10,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
