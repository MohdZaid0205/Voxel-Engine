<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ExpanderStyle.Primary" TargetType="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource brush_text_primary}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <!--  Header toggle  -->
                        <ToggleButton
                            x:Name="HeaderToggle"
                            Padding="0,10"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                                            <Path
                                                x:Name="Chevron"
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M 0 0 L 5 5 L 10 0"
                                                RenderTransformOrigin="0.5,0.5"
                                                Stroke="{DynamicResource brush_text_muted}"
                                                StrokeEndLineCap="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ChevronRot" Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="ChevronRot"
                                                            Storyboard.TargetProperty="Angle"
                                                            To="180"
                                                            Duration="0:0:0.18" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="ChevronRot"
                                                            Storyboard.TargetProperty="Angle"
                                                            To="0"
                                                            Duration="0:0:0.18" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource brush_text_primary}"
                                Text="{TemplateBinding Header}" />
                        </ToggleButton>
                        <!--  Divider under header  -->
                        <Border Height="1" Background="{DynamicResource brush_border_subtle}" />
                        <!--  Content with animated max-height  -->
                        <ContentPresenter
                            x:Name="ContentSite"
                            MaxHeight="0"
                            Margin="0,8,0,0"
                            ContentSource="Content">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="ContentSlide" Y="-8" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentSite"
                                            Storyboard.TargetProperty="MaxHeight"
                                            To="600"
                                            Duration="0:0:0.22" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentSlide"
                                            Storyboard.TargetProperty="Y"
                                            To="0"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentSite"
                                            Storyboard.TargetProperty="MaxHeight"
                                            To="0"
                                            Duration="0:0:0.18" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentSlide"
                                            Storyboard.TargetProperty="Y"
                                            To="-8"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
