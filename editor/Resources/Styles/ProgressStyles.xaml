<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  ProgressBarStyle.Primary                              -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style x:Key="ProgressBarStyle.Primary" TargetType="ProgressBar">
        <Setter Property="Height"             Value="6"/>
        <Setter Property="BorderThickness"    Value="0"/>
        <Setter Property="Background"         Value="{DynamicResource brush_bg_overlay}"/>
        <Setter Property="Foreground"         Value="{DynamicResource brush_accent}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Track -->
                        <Border x:Name="PART_Track"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"/>
                        <!-- Fill indicator -->
                        <Border x:Name="PART_Indicator"
                                CornerRadius="3"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
