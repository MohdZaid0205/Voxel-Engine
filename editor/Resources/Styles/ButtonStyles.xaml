<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  ButtonStyle.Primary                                   -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style x:Key="ButtonStyle.Primary" TargetType="Button">
        <Setter Property="Foreground"              Value="{DynamicResource brush_text_primary}"/>
        <Setter Property="FontFamily"              Value="Segoe UI"/>
        <Setter Property="FontSize"                Value="13"/>
        <Setter Property="FontWeight"              Value="Regular"/>
        <Setter Property="Padding"                 Value="14,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Cursor"                  Value="Hand"/>
        <Setter Property="SnapsToDevicePixels"     Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource brush_bg_elevated}"
                            BorderBrush="{DynamicResource brush_bg_elevated}"
                            BorderThickness="2"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource brush_bg_hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource brush_border_strong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource brush_bg_hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource brush_accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource brush_accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  ButtonStyle.Secondary                                   -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style x:Key="ButtonStyle.Secondary" TargetType="Button">
        <Setter Property="Foreground"              Value="{DynamicResource brush_text_primary}"/>
        <Setter Property="FontFamily"              Value="Segoe UI"/>
        <Setter Property="FontSize"                Value="13"/>
        <Setter Property="FontWeight"              Value="Regular"/>
        <Setter Property="Padding"                 Value="14,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Cursor"                  Value="Hand"/>
        <Setter Property="SnapsToDevicePixels"     Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource brush_bg_elevated}"
                            BorderBrush="{DynamicResource brush_bg_elevated}"
                            BorderThickness="2"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource brush_bg_hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource brush_border_strong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource brush_bg_hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource brush_accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  ButtonStyle.Accent  (gradient fill)                   -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style x:Key="ButtonStyle.Accent" TargetType="Button">
        <Setter Property="Foreground"              Value="{DynamicResource brush_text_on_accent}"/>
        <Setter Property="FontFamily"              Value="Segoe UI"/>
        <Setter Property="FontSize"                Value="13"/>
        <Setter Property="FontWeight"              Value="SemiBold"/>
        <Setter Property="Padding"                 Value="14,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Cursor"                  Value="Hand"/>
        <Setter Property="SnapsToDevicePixels"     Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource brush_accent_gradient}"
                            BorderThickness="0"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

